# Revelation RT v3 modifications, 2026-10-26. Apache-2.0.
option.RT_LOCAL_LIGHTS=Local world lights
option.RT_LOCAL_BRIGHTNESS=Local light brightness
option.RT_LOCAL_SOFT_SHADOWS=Local Light Soft Shadows
option.RT_LOCAL_SOFT_SHADOWS.comment=Samples occlusion across the emitter's own disc for distance-dependent contact-hardening penumbra. Off uses one hard ray per pixel.
option.RT_LOCAL_SHADOW_SAMPLES=Local Light Shadow Samples
option.RT_LOCAL_SHADOW_SAMPLES.comment=Occlusion samples per emitter, converged by TAA. 1 keeps crisp edges; higher values smooth the penumbra at extra cost.
option.RT_LOCAL_SPECULAR=Local Light Specular
option.RT_LOCAL_SPECULAR.comment=GGX highlight share from torches and lanterns on smooth surfaces. 0 disables it.
option.RT_HANDHELD_SHADOWS.comment=Trace captured local model bounds instead of single-layer camera depth.

# Revelation RT v5, Apache-2.0.
option.RT_PHYSICAL_GLASS=Solid glass optics
option.RT_PHYSICAL_GLASS.comment=Snell entry/exit refraction, thickness-based absorption and Fresnel reflection. Reconstructs the frontmost glass cell, not full multilayer path tracing.
option.RT_GLASS_ROUGHNESS=Glass surface roughness
option.RT_GLASS_ROUGHNESS.comment=0 is a sharp mirror. Higher values sample a GGX microfacet reflection; use more reflection samples to reduce noise.
option.RT_LOCAL_LIGHTS.comment=64-block capture grid, up to 256 emitters. Accumulates every influencing light; traces vanilla door, trapdoor, bar and grate cutouts.
option.RT_GLASS_DENSITY.comment=Shared absorption per block of actual glass path length. Thin panes absorb less than full cubes; multiple layers multiply.
option.RT_HANDHELD_RADIUS.comment=0 is a point source; a positive radius gives contact-hardening soft shadows with TAA convergence.

# Revelation RT v6, Apache-2.0.
option.RT_LOCAL_ACCELERATION=Hierarchical local ray traversal
option.RT_LOCAL_ACCELERATION.comment=Combine opaque visibility and glass in one traversal; skip empty 4-block bricks using 64-bit occupancy masks. Retains 1/16-block cutouts.
option.RT_LOCAL_SOURCE_SIZE=Local emitting surface size
option.RT_LOCAL_SOURCE_SIZE.comment=Smaller sources make aperture projections sharper; larger sources widen the penumbra. Does not change the light range.
option.RT_LOCAL_VOLUMETRICS=Local volumetric lighting
option.RT_LOCAL_VOLUMETRICS.comment=Accumulates candidate lights along the view ray with source-to-medium and medium-to-camera extinction. Limited by sampling and the local capture grid.
option.RT_LOCAL_VOLUME_SAMPLES=Local volume samples
option.RT_LOCAL_HAZE_DENSITY=Local haze density
option.RT_LOCAL_HAZE_DENSITY.comment=0 disables local haze; suggested range 0.004 to 0.012. Higher values increase visible scattering and extinction.

option.RT_LOCAL_HALF_RES=Half-resolution local diffuse
option.RT_LOCAL_TRACED_SHADOWS=Ray-traced local shadows (expensive)
option.RT_LOCAL_TEMPORAL_SHADOWS=One shadow sample per frame (temporal)
option.RT_LOCAL_MAX_TRACED=Ray-traced lights per pixel
option.RT_LOCAL_IMPORTANCE_CUTOFF=Drop lights below this share of the strongest
option.RT_LOCAL_VOLUME_LIGHT_CAP=Haze lights along the ray

