screen.RayTracing=Software Ray Tracing (Experimental)
option.RTGI_ENABLED=Path-traced Indirect Light
option.RTGI_ENABLED.comment=Screen-space diffuse paths with explicit bounces. Requires Global Illumination. No off-screen or hidden geometry; not hardware RTX.
option.RTGI_SAMPLES=Paths per Pixel
option.RTGI_SAMPLES.comment=Samples per frame at half resolution. Higher values reduce noise and increase GPU cost.
option.RTGI_BOUNCES=Diffuse Bounces
option.RTGI_BOUNCES.comment=Trace 1-4 explicit bounces using an independent direct-only radiance cache.
option.RT_MAX_DISTANCE=Maximum Ray Segment Distance
suffix.RT_MAX_DISTANCE= blocks
option.RT_MAX_DISTANCE.comment=Also affects reflections and refraction. Longer rays need more steps; they do not provide off-screen geometry.
option.RT_HIT_THICKNESS=Intersection Thickness
suffix.RT_HIT_THICKNESS= blocks
option.RT_HIT_THICKNESS.comment=Depth-slab tolerance. Large values can cause false occlusion; small values can miss thin surfaces.
option.RT_RADIANCE_CLAMP=Indirect Radiance Limit
option.RT_RADIANCE_CLAMP.comment=Suppresses fireflies while preserving hue. Lower limits darken bright indirect lighting.
option.RT_SPECULAR_SAMPLES=Rough Reflection Samples
option.RT_SPECULAR_SAMPLES.comment=Multiple GGX importance-sampled reflection rays. Mirror surfaces use one ray.
option.RT_HANDHELD_SHADOWS=Ray-traced Handheld Shadows
option.RT_HANDHELD_SHADOWS.comment=Independent main/off-hand lights with screen-space opaque occlusion. Off-screen occluders are unavailable.
option.RT_HANDHELD_SHADOW_SAMPLES=Handheld Shadow Steps
option.RT_HANDHELD_RADIUS=Handheld Source Radius
suffix.RT_HANDHELD_RADIUS= blocks
option.RT_HANDHELD_FLICKER=Subtle Flame Flicker
option.RT_HANDHELD_FLICKER.comment=Small continuous brightness variation for torch and soul-flame items.
option.RT_TEMPORAL_CLIP=Indirect History Clipping
option.RT_TEMPORAL_CLIP.comment=Variance-based neighborhood clipping reduces stale lighting trails. Requires SVGF.
option.RT_CLIP_SIGMA=History Clip Tolerance
option.RT_CLIP_SIGMA.comment=Lower values react faster but may increase noise and flicker.

# Revelation RT v2 modifications, 2026-10-26. Apache-2.0.
option.RT_HANDHELD_SOFT_SAMPLES=Fixed Handheld Soft-shadow Samples
option.RT_HANDHELD_SOFT_SAMPLES.comment=Used only for a nonzero source radius. More samples reduce banding and increase GPU cost.
