// Revelation RT v7, Apache-2.0. One ray bundle per 2x2 receiver group.
#include "/lib/Utility.glsl"
layout(local_size_x = 8, local_size_y = 8) in;
const vec2 workGroupsRender = vec2(0.5, 0.5);
#include "/lib/universal/Uniform.glsl"
#include "/lib/universal/SSBO.glsl"
#include "/lib/universal/Transform.glsl"
#include "/lib/universal/Fetch.glsl"
#include "/lib/universal/Random.glsl"
#include "/lib/surface/Material.glsl"
#include "/lib/surface/Selection.glsl"
#include "/lib/lighting/BRDF.glsl"
#ifdef HANDHELD_LIGHTING
#include "/lib/lighting/HandheldTracing.glsl"
#endif
#ifdef RT_LOCAL_LIGHTS
#include "/lib/lighting/LocalLights.glsl"
#endif
#include "/lib/lighting/LocalLightCache.glsl"
#ifdef RT_LOCAL_HALF_RES
#if defined RT_LOCAL_LIGHTS || defined HANDHELD_LIGHTING
layout(rgba16f) writeonly uniform image2D rtLocalDiffuseImg;
layout(rgba16f) writeonly uniform image2D rtLocalSpecularImg;
#endif
#endif
void main() {
#ifdef RT_LOCAL_HALF_RES
#if defined RT_LOCAL_LIGHTS || defined HANDHELD_LIGHTING
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, min(imageSize(rtLocalDiffuseImg), ivec2(scaledHalfViewSize))))) return;
    imageStore(rtLocalDiffuseImg, p, vec4(0.0));
    imageStore(rtLocalSpecularImg, p, vec4(0.0));
    ivec2 full = min(p * 2 + 1, ivec2(scaledViewSize) - 1);
    if (!RTLocalLightingRelevant(full)) return;
    float depth = loadDepth0(full);
    uvec4 pack = loadMaterialPack(full);
    if (depth < 0.56 || depth > 1.0 - EPS || pack.y == 0u || pack.y == rtSelectionMaterial) return;
#ifdef PARALLAX_SHADOW
    depth += texelFetch(colortex12, full, 0).x;
#endif
    vec3 viewPos = ScreenToViewPos(vec3((vec2(full) + 0.5) * scaledTexelSize, depth));
    Material material = GetMaterialData(ExtractSpecularTex(pack), FetchBaseColor(full));
    // Rough PBR surfaces share both lobes; only narrow mirror lobes stay native.
    if (material.specularMask && material.roughness < 0.08) return;
    vec3 geoNormal, normal;
    FetchNormalData(full, geoNormal, normal);
    vec3 diffuse = vec3(0.0), specular = vec3(0.0);
    float dither = BlueNoise(full, frameCounter);
#ifdef HANDHELD_LIGHTING
    AddTracedHandheldLighting(viewPos, normal, geoNormal, material, false, dither, full, diffuse, specular);
#endif
#ifdef RT_LOCAL_LIGHTS
    AddTracedLocalLighting(viewPos, normal, geoNormal, material, false, dither, full, diffuse, specular);
#endif
    imageStore(rtLocalDiffuseImg, p, vec4(clamp(diffuse, vec3(0.0), vec3(FP16_MAX)), viewPos.z));
    imageStore(rtLocalSpecularImg, p, vec4(clamp(specular, vec3(0.0), vec3(FP16_MAX)), 1.0));
#endif
#endif
}
